# OpenWrt build config for Newland NL-WR8103 (MT7981B)
# Source: hanimeia/openwrt main branch (contains PR #19006 device support)
# Target: mediatek/filogic, device newland_nl-wr8103
# Minimal first build: base system only, NO LuCI (option 1, chosen 2026-11-07 18:36 — keeps feeds current, no web UI; manage via SSH/CLI).
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_newland_nl-wr8103=y
# CONFIG_PACKAGE_luci is not set
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
